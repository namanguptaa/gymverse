# Copy this file to .env and change what you need. All values are optional.

# Port the server listens on
PORT=3000

# Where the database and backups are stored (relative to the project folder)
DATA_DIR=data

# How many daily backups to keep in DATA_DIR/backups
BACKUP_KEEP=30

# How many days a sign-in lasts on a device
SESSION_DAYS=90

# Set to true when GymVerse is served over HTTPS
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (Caddy, Nginx, Traefik)
TRUST_PROXY=false
